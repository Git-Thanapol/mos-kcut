---
import '../styles/global.css';
// cache-busting for the un-fingerprinted scripts in /public: changes on every build
const v = Date.now().toString(36);
---
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="KCUT ระบบตัดคลิปวิดีโออัจฉริยะ ถอดเสียงและสร้างซับอัตโนมัติ ตัดช่วงเสียงเงียบ แปลซับ ใช้งานผ่านเบราว์เซอร์ได้ทั้งคอมและมือถือ">
    <title>KCUT - ระบบตัดคลิปวิดีโออัจฉริยะ</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;600;700&display=swap" rel="stylesheet">
</head>
<body class="antialiased">
    <slot />

    <script is:inline src={`/checkout.js?v=${v}`} defer></script>
    <script is:inline src={`/address.js?v=${v}`} defer></script>
    <script is:inline src={`/modals.js?v=${v}`} defer></script>
</body>
</html>
