                    ได้ทั้งคอม และ มือถือสมาร์ทโฟน
                </div>

                <!-- 3. รูปด้านขวา: โลโก้ Google Chrome -->
                <div class="flex-shrink-0 transform hover:scale-105 transition-transform">
                    <img loading="lazy" decoding="async" src="/chrome.webp" width="128" height="128" alt="Google Chrome Logo" class="h-10 w-10 sm:h-12 sm:w-12 md:h-16 md:w-16 object-contain drop-shadow-lg">
                </div>
                
            </div>
        </div>
