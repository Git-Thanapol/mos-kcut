---
import { asset } from '../data/content';
---
    <section class="bg-[#0A1224] py-16 md:py-24 border-t border-slate-800 font-prompt">
        <div class="container mx-auto px-4 max-w-6xl flex flex-col md:flex-row items-center justify-between gap-12 md:gap-8">
            <div class="flex-1 w-full space-y-6 md:pl-8">
                <div>
                    <p class="text-[#E5A93D] font-bold text-sm md:text-base mb-2">เลือกวิธีที่คุณสะดวก</p>
                    <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight text-white mb-2">
                        พร้อมเริ่มใช้งานแล้ว? <br>
                        <span class="text-[#E5A93D]">สมัครเอง หรือให้เราช่วย</span>
                    </h2>
                </div>
                <div class="space-y-4 max-w-md pt-2">
                    <a href="#register" class="block w-full text-center bg-gradient-to-b from-[#FAD26C] to-[#DF9B15] text-[#0A1224] font-bold py-4 rounded-xl border-b-[6px] border-[#B3780D] active:border-b-0 active:translate-y-[6px] hover:brightness-105 transition-all text-xl shadow-lg">
                        สมัครใช้งานด้วยตัวเอง
                    </a>
                    <a href="https://lin.ee/YmWfY9Kv" target="_blank" class="block w-full text-center bg-gradient-to-b from-[#1C964A] to-[#10662F] text-white font-bold py-4 rounded-xl border-b-[6px] border-[#0A471E] active:border-b-0 active:translate-y-[6px] hover:brightness-105 transition-all text-xl shadow-lg">
                        ให้แอดมินช่วยสมัคร
                    </a>
                </div>
                <div class="pt-4 space-y-3">
                    <p class="text-slate-300 text-sm md:text-base leading-relaxed">
                        สมัครเอง: เลือกแพ็คเกจ กรอกข้อมูล และชำระเงิน<br>
                        สมัครแล้ว เข้า LINE รับวิธีเข้าใช้งานระบบ
                    </p>
                    <p class="text-white font-bold text-lg md:text-xl tracking-wide mt-2">
                        LINE: @spgo <span class="font-normal text-slate-400 text-sm md:text-base">(มี @ ด้านหน้า)</span>
                    </p>
                </div>
            </div>
            <div class="flex-shrink-0 w-full md:w-auto flex justify-center md:pr-8">
                <div class="bg-white rounded-[2rem] p-8 w-[300px] md:w-[320px] shadow-2xl text-center transform hover:scale-[1.02] transition-transform duration-300">
                    <div class="bg-white border-2 border-dashed border-gray-300 rounded-2xl p-3 mb-6 flex justify-center items-center">
                         <img loading="lazy" decoding="async" src={asset('/qrcode.webp')} width="480" height="480" alt="LINE QR Code" class="w-full h-auto rounded-xl object-contain">
                    </div>
                    <h3 class="text-[#0A1224] text-2xl md:text-3xl font-extrabold mb-3">@spgo</h3>
                    <p class="text-slate-600 text-sm md:text-base leading-relaxed">
                        สแกนเพื่อคุยกับแอดมิน<br>ทาง LINE
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer Copyright ปิดท้าย -->
    <div class="bg-[#0A1224] py-6 text-center border-t border-slate-800/50">
        <p class="text-slate-500 text-sm font-light">© 2026 SWIFT PASSION CO., LTD. All rights reserved.</p>
    </div>

    <!-- แถบ Sticky Bar -->
    <div class="fixed bottom-0 left-0 w-full bg-slate-900 border-t border-slate-700 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.2)] z-50 py-3 px-4">
        <div class="container mx-auto max-w-6xl flex justify-center items-center w-full">
            <div class="flex items-center justify-center space-x-4 md:space-x-8 w-full md:w-auto">
                <div class="hidden md:block text-right flex-shrink-0">
                    <p class="font-bold text-white text-lg">แพ็คเกจเริ่มต้น</p>
                    <p class="text-slate-300 text-sm">เพียง 390 บาท/เดือน</p>
                </div>
                <div class="flex w-full md:w-auto space-x-3 md:space-x-4">
                    <a href="#register" class="flex-1 md:flex-none text-center bg-gradient-to-b from-amber-300 to-amber-500 hover:from-amber-400 hover:to-amber-600 text-slate-900 font-bold py-3 md:py-2 px-6 md:px-10 rounded-xl transition shadow-md border-b-4 border-amber-600 active:border-b-0 active:mt-1 whitespace-nowrap">
                        สมัครใช้งาน
                    </a>
                    <a href="https://lin.ee/YmWfY9Kv" target="_blank" class="flex-1 md:flex-none text-center bg-gradient-to-b from-[#00c300] to-[#009900] hover:from-[#00d000] hover:to-[#00a000] text-white font-bold py-3 md:py-2 px-6 md:px-10 rounded-xl transition shadow-md border-b-4 border-[#007700] active:border-b-0 active:mt-1 whitespace-nowrap">
                        สอบถามแอดมิน
                    </a>
                </div>
            </div>
        </div>
    </div>
    
    <!-- เผื่อพื้นที่ด้านล่างสุดของเว็บไว้เล็กน้อย -->
    <div class="h-24 md:h-20 bg-slate-900"></div>

    <!-- ========================================== -->
    <!-- กล่อง Modal สำหรับ Popup วิดีโอ (ซ่อนไว้เริ่มต้น) -->
