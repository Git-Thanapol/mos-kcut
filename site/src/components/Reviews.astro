---
const { reviews } = Astro.props;
const br = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').split('\n').join('<br>');
---
    <section class="bg-slate-800 py-16 border-t border-slate-700">
        <div class="container mx-auto px-4 max-w-6xl">
            <h3 class="text-3xl md:text-4xl font-bold text-center mb-10 text-white">เสียงตอบรับจากผู้ใช้งาน</h3>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
                
{reviews.map((r, i) => (
                <div class="bg-white rounded-3xl p-6 shadow-xl border border-gray-200 flex flex-col text-left transform hover:-translate-y-1 transition-transform duration-300">
                    <div class="flex justify-between items-center mb-3">
                        <p class="text-blue-600 font-bold text-sm">รีวิวผู้ใช้งาน</p>
                        <!-- ไอคอนดาว 5 ดวง -->
                        <div class="flex text-amber-400">
                            {[0, 1, 2, 3, 4].map((n) => (<svg xmlns="http://www.w3.org/2000/svg" class={`h-4 w-4 md:h-5 md:w-5${n < r.rating ? '' : ' text-gray-300'}`} viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>))}
                        </div>
                    </div>
                    <h4 class="text-[#0A1224] text-xl md:text-2xl font-extrabold leading-tight mb-3"><Fragment set:html={br(r.headline)} /></h4>
                    <p class="text-gray-500 text-sm mb-4">{r.name}</p>
                    <p class="text-gray-700 text-sm mb-6 leading-relaxed"><Fragment set:html={br(r.body)} /></p>
                    
                    <div class="mt-auto border border-gray-200 rounded-xl overflow-hidden bg-gray-50 flex flex-col cursor-pointer group" onclick={`openImageModal('${r.image}')`}>
                        <img src={r.image} alt={`รีวิวแชทลูกค้า ${i + 1}`} loading="lazy" decoding="async" class="w-full h-40 md:h-48 object-cover object-top group-hover:opacity-90 transition-opacity">
                        <div class="bg-[#F4F6F9] group-hover:bg-[#E2E8F0] text-[#0A1224] text-center font-bold py-3 transition-colors text-sm">
                            แตะดูภาพใหญ่ +
                        </div>
                    </div>
                </div>
))}

            </div>
        </div>
    </section>
