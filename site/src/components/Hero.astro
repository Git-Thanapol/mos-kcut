---
import { asset } from '../data/content';
const { hero, features } = Astro.props;
---
    <section class="container mx-auto px-4 pt-4 pb-6 md:pt-6 md:pb-8 max-w-6xl flex flex-col items-center">
        
        <!-- รูปภาพและวิดีโอรวมกัน -->
        <div class="w-full mb-10 md:mb-12 max-w-5xl shadow-2xl rounded-2xl md:rounded-3xl overflow-hidden border border-slate-700 flex flex-col bg-slate-900">
            <img src={hero.image} width="1254" height="1254" fetchpriority="high" decoding="async" alt="ระบบ KCUT" class="w-full h-auto object-cover border-b border-slate-700">
            <div id="video-demo" class="w-full relative aspect-video flex items-center justify-center scroll-mt-24">
                <video src={hero.video} poster={hero.poster} preload="none"
                       controls 
                       playsinline 
                       class="w-full h-full object-cover relative z-20">
                </video>
            </div>
        </div>

        <!-- หัวข้อใหม่ -->
        <div class="w-full text-center max-w-4xl mb-10">
            <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white">
                <span class="gradient-text">KCUT</span> ทำอะไรได้บ้าง?
            </h2>
        </div>

        <!-- กล่อง 10 ฟังก์ชันการทำงาน -->
        <div class="bg-slate-800/80 backdrop-blur-sm border border-slate-700 rounded-2xl md:rounded-3xl p-6 md:p-10 w-full shadow-xl">
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
{features.map((f, i) => (
                <!-- ข้อ 1 -->
                <div class="flex items-start space-x-4 cursor-pointer group p-3 -m-3 rounded-2xl hover:bg-slate-700/50 transition-all duration-300 border border-transparent hover:border-slate-600" onclick={`openVideoModal('${f.video}')`}>
                    <div class="flex-shrink-0 w-8 h-8 rounded-full bg-amber-500/20 text-amber-500 flex items-center justify-center font-bold border border-amber-500/30 text-sm shadow-inner group-hover:scale-110 group-hover:bg-amber-500 group-hover:text-slate-900 transition-all">{i + 1}</div>
                    <div>
                        <p class="text-slate-300 text-sm md:text-base leading-relaxed group-hover:text-white transition-colors"><strong class="text-white group-hover:text-amber-400 transition-colors">{f.title}</strong> {f.desc}</p>
                        <div class="h-0 overflow-hidden group-hover:h-auto group-hover:mt-2 transition-all duration-300">
                            <p class="text-amber-500 text-xs flex items-center font-semibold">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" /></svg>กดเพื่อดูตัวอย่าง
                            </p>
                        </div>
                    </div>
                </div>
))}
            </div>

            <!-- ปุ่มกระตุ้นให้กลับขึ้นไปดูวิดีโอ -->
            <div class="mt-8 flex flex-col items-center justify-center border-t border-slate-700/50 pt-8">
                <p class="text-white text-lg md:text-xl font-bold mb-4 text-center">
                    อยากรู้ว่าใช้งานง่ายแค่ไหน? <span class="text-amber-400">ลองดูคลิปด้านบนเลย! 👆</span>
                </p>
                <a href="#video-demo" onclick="document.getElementById('video-demo').scrollIntoView({behavior: 'smooth'}); return false;" 
                   class="group flex items-center space-x-2 bg-slate-700 hover:bg-slate-600 border border-slate-600 text-white py-3 px-6 rounded-full transition-all duration-300 shadow-lg hover:shadow-amber-500/20">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-amber-500 group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span class="font-semibold text-sm md:text-base">เลื่อนขึ้นไปดูวิดีโอสาธิตการใช้งาน</span>
                </a>
            </div>

            <!-- แทนที่ข้อความสั่งซื้อด้วย รูป 2 รูป (Grid 1 คอลัมน์ในมือถือ, 2 คอลัมน์ในจอใหญ่) -->
            <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-4 border-t border-slate-700/50 pt-8">
                <img loading="lazy" decoding="async" src={asset('/pic3.webp')} width="900" height="900" alt="รูปเพิ่มเติม 1" class="w-full h-auto rounded-xl md:rounded-2xl shadow-lg border border-slate-700 object-cover hover:scale-[1.02] transition-transform duration-300">
                <img loading="lazy" decoding="async" src={asset('/pic4.webp')} width="900" height="900" alt="รูปเพิ่มเติม 2" class="w-full h-auto rounded-xl md:rounded-2xl shadow-lg border border-slate-700 object-cover hover:scale-[1.02] transition-transform duration-300">
            </div>

        </div>
    </section>
