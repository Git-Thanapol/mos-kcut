---
import { asset } from '../data/content';
---
    <section class="container mx-auto px-4 py-16 max-w-5xl">
        <h3 class="text-3xl md:text-4xl font-bold text-center mb-10">เลือกแพ็คเกจที่ใช่สำหรับคุณ</h3>
        
        <img loading="lazy" decoding="async" src={asset('/ads04.webp')} width="1280" height="1280" alt="เลือกแพ็คเกจ KCUT" class="mx-auto rounded-xl md:rounded-3xl shadow-2xl w-full mb-10 md:mb-14 border border-slate-700">
        
        <!-- ========================================== -->
        <!-- ส่วนที่ 1: แพ็คเกจตลอดชีพ (กล่องใหญ่ด้านบน) -->
        <!-- ========================================== -->
        <div class="bg-gradient-to-br from-slate-800 to-slate-900 rounded-2xl md:rounded-3xl overflow-hidden shadow-2xl border-2 border-amber-500 relative flex flex-col md:flex-row mb-6 md:mb-10 transform hover:-translate-y-1 transition-transform duration-300">
            <!-- ป้ายขายดีสุด -->
            <div class="absolute top-0 right-0 bg-amber-500 text-slate-900 font-bold px-3 py-1 md:px-4 md:py-1.5 text-xs md:text-base rounded-bl-xl z-10 shadow-md">
                ขายดีสุด
            </div>
            
            <!-- ฝั่งรูปภาพ (ซ้าย) -->
            <div class="w-full md:w-1/2 flex items-center justify-center bg-slate-900/50 p-4 md:p-6">
                <img loading="lazy" decoding="async" src={asset('/card-lifetime.webp')} width="800" height="800" alt="แพ็คเกจ ตลอดชีพ" class="w-full h-auto object-contain rounded-xl shadow-lg hover:scale-105 transition-transform duration-300">
            </div>
            
            <!-- ฝั่งข้อความและราคา (ขวา) -->
            <div class="w-full md:w-1/2 p-6 md:p-10 flex flex-col justify-center text-center md:text-left">
                <h4 class="text-xl md:text-4xl font-bold mb-2 md:mb-3 text-amber-400">แพ็คเกจ ตลอดชีพ</h4>
                <p class="text-slate-300 text-xs md:text-base mb-4 md:mb-6">จ่ายครั้งเดียว ใช้งานได้ตลอดชีพ พร้อมรับการอัปเดตฟีเจอร์ใหม่ๆ ฟรีตลอดไป</p>
                <div class="mb-6 md:mb-8">
                    <p class="text-4xl md:text-6xl font-black text-amber-500 drop-shadow-md">5,990 <span class="text-sm md:text-2xl text-slate-400 font-normal">บาท</span></p>
                </div>
                <a href="#register" class="inline-block w-full text-center bg-gradient-to-r from-amber-400 to-amber-600 hover:from-amber-500 hover:to-amber-700 text-slate-900 font-bold py-3 md:py-4 rounded-xl transition shadow-lg text-base md:text-xl border-b-4 border-amber-700 active:border-b-0 active:translate-y-1">
                    เลือกลงทุนแพ็คเกจนี้
                </a>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- ส่วนที่ 2: แพ็คเกจ 1 เดือน คู่กับ 1 ปี (บังคับ 2 คอลัมน์ในมือถือ) -->
        <!-- ========================================== -->
        <!-- เปลี่ยนจาก grid-cols-1 เป็น grid-cols-2 เพื่อให้คู่กันเสมอ -->
        <div class="grid grid-cols-2 gap-3 md:gap-8">
            
            <!-- แพ็คเกจ 1 เดือน (ซ้าย) -->
            <div class="bg-slate-800 rounded-xl md:rounded-3xl overflow-hidden shadow-xl border border-slate-700 flex flex-col transform hover:-translate-y-1 transition-transform duration-300">
                <div class="p-2 md:p-6 bg-slate-900/30 flex justify-center">
                    <img loading="lazy" decoding="async" src={asset('/card-monthly.webp')} width="600" height="600" alt="แพ็คเกจ 1 เดือน" class="w-full h-auto max-w-sm object-contain rounded-lg md:rounded-xl shadow-md hover:scale-105 transition-transform duration-300">
                </div>
                <div class="p-3 md:p-8 text-center flex-grow flex flex-col justify-between">
                    <div class="mb-3 md:mb-6">
                        <h4 class="text-sm md:text-2xl font-bold mb-1 md:mb-3 text-white">แพ็คเกจ 1 เดือน</h4>
                        <p class="text-2xl md:text-5xl font-black text-white">390 <span class="text-[10px] md:text-xl text-slate-400 font-normal">บาท</span></p>
                    </div>
                    <a href="#register" class="block w-full bg-slate-700 hover:bg-slate-600 text-white font-bold py-2 md:py-4 rounded-lg md:rounded-xl transition text-xs md:text-lg shadow-md border border-slate-600">
                        เลือกแพ็คเกจนี้
                    </a>
                </div>
            </div>

            <!-- แพ็คเกจ 1 ปี (ขวา) -->
            <div class="bg-slate-800 rounded-xl md:rounded-3xl overflow-hidden shadow-xl border border-slate-700 flex flex-col transform hover:-translate-y-1 transition-transform duration-300">
                <div class="p-2 md:p-6 bg-slate-900/30 flex justify-center">
                    <img loading="lazy" decoding="async" src={asset('/card-yearly.webp')} width="600" height="600" alt="แพ็คเกจ 1 ปี" class="w-full h-auto max-w-sm object-contain rounded-lg md:rounded-xl shadow-md hover:scale-105 transition-transform duration-300">
                </div>
                <div class="p-3 md:p-8 text-center flex-grow flex flex-col justify-between">
                    <div class="mb-3 md:mb-6">
                        <h4 class="text-sm md:text-2xl font-bold mb-1 md:mb-3 text-white">แพ็คเกจ 1 ปี</h4>
                        <p class="text-2xl md:text-5xl font-black text-white">3,990 <span class="text-[10px] md:text-xl text-slate-400 font-normal">บาท</span></p>
                    </div>
                    <a href="#register" class="block w-full bg-slate-700 hover:bg-slate-600 text-white font-bold py-2 md:py-4 rounded-lg md:rounded-xl transition text-xs md:text-lg shadow-md border border-slate-600">
                        เลือกแพ็คเกจนี้
                    </a>
                </div>
            </div>

        </div>
    </section>

