# --- server (copy to .env or put in /etc/kcut/api.env). Placeholders only — never commit real values.
PORT=3000
HOST=127.0.0.1
TRUST_PROXY=1                      # 1 when running behind nginx
ADMIN_PASSWORD=                    # protects /admin; if empty a random one is printed at start

# Orders live in SQLite (DATA_DIR/kcut.db) and payment slips in DATA_DIR/slips.
DATA_DIR=                          # default: ./data  (production: /var/lib/kcut, back it up)

# Email: leave SMTP_PASS empty to use the MOCK mailer (writes files to data/outbox/).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=spmarketgo@gmail.com
SMTP_PASS=                         # Gmail App Password
SHOP_NOTIFY_EMAIL=spmarketgo@gmail.com

# Content admin (/admin/content): rebuilds the site from site/data/content.json. Needs ffmpeg for video uploads.
SITE_DIR=                          # default: ../site
FFMPEG_PATH=                       # default: ffmpeg on PATH (apt install ffmpeg)
